<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <!-- The database contains encrypted credentials and device-specific filesystem indexes. -->
    <cloud-backup>
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
